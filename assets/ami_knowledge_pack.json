        {"plan_code": "PLAN-CARD-CAD-AMI-STATIN-THERAPY", "plan_name": "高强度他汀降脂方案"},
        {"plan_code": "PLAN-CARD-CAD-AMI-BETA-BLOCKER-THERAPY", "plan_name": "β受体阻滞剂方案"}
      ]
    }
  },

  "treatment_plans": {
    "STEMI_emergency_pci": {
      "name": "STEMI急诊PCI",
      "priority": "首选",
      "conditions": ["确诊STEMI", "发病<12h", "无PCI禁忌证"],
      "contraindications": ["活动性内出血", "近期大手术(2周内)", "严重未控制高血压>200/120mmHg", "主动脉夹层"],
      "pre_orders": [
        "阿司匹林300mg嚼服",
        "P2Y12抑制剂负荷（氯吡格雷600mg或替格瑞洛180mg）",
        "普通肝素60-70U/kg（最大4000U）静推",
        "建立静脉通路",
        "床旁心电监护"
      ],
      "procedure": "急诊冠脉造影+经皮冠状动脉介入治疗(PCI)",
      "post_orders": [
        "双联抗血小板治疗(DAPT)≥12个月",
        "高强度他汀（阿托伐他汀40-80mg或瑞舒伐他汀20mg）",
        "β受体阻滞剂（无禁忌时）",
        "ACEI/ARB（前壁梗死/心衰/EF≤40%时）",
        "醛固酮拮抗剂（EF≤40%+心衰/糖尿病时）"
      ],
      "guideline": "ESC STEMI Guidelines 2017, ACC/AHA STEMI Guidelines 2013"
    },
    "STEMI_thrombolysis": {
      "name": "STEMI溶栓治疗",
      "priority": "次选（无法行急诊PCI时）",
      "conditions": ["确诊STEMI", "发病<12h", "无法在120min内行PCI", "无溶栓禁忌证"],
      "contraindications": [
        "活动性内出血", "出血性卒中史", "缺血性卒中3个月内",
        "颅内肿瘤/AVM/动脉瘤", "已知出血倾向", "严重未控制高血压",
        "近期大手术(2周内)", "主动脉夹层", "妊娠"
      ],
      "agents": [
        {"name": "阿替普酶(rt-PA)", "dose": "15mg静推+0.75mg/kg(30min)+0.5mg/kg(60min)，最大100mg"},
        {"name": "替奈普酶(TNK-tPA)", "dose": "根据体重单次静推：30mg(<60kg)至50mg(≥90kg)"},
        {"name": "瑞替普酶(r-PA)", "dose": "10U静推+10U静推(30min后)"}
      ],
      "adjunct": ["普通肝素或低分子肝素", "阿司匹林300mg", "氯吡格雷300mg负荷"],
      "success_criteria": ["胸痛缓解>50%", "抬高ST段回落>50%", "再灌注心律失常", "cTn峰值前移"],
      "guideline": "ESC STEMI Guidelines 2017"
    },
    "NSTEMI_conservative": {
      "name": "NSTEMI药物保守治疗",
      "priority": "低中危NSTEMI",
      "conditions": ["确诊NSTEMI", "GRACE评分≤108（低危）", "无反复缺血发作"],
      "orders": [
        "双联抗血小板：阿司匹林100mg qd + 氯吡格雷75mg qd",
        "抗凝：低分子肝素（依诺肝素1mg/kg q12h）",
        "他汀：阿托伐他汀20-40mg qn",
        "β受体阻滞剂：美托洛尔缓释片47.5mg qd（无禁忌时）",
        "ACEI/ARB（合并心衰/糖尿病/肾功能不全时）",
        "硝酸酯类（胸痛发作时）"
      ],
      "monitoring": ["持续心电监护", "q6h cTn", "每日心电图", "肾功能/电解质"],
      "guideline": "ESC NSTE-ACS Guidelines 2020"
    },
    "NSTEMI_invasive": {
      "name": "NSTEMI侵入性策略",
      "priority": "高危NSTEMI",
      "conditions": ["确诊NSTEMI", "GRACE评分>140（高危）", "或反复缺血发作", "或血流动力学不稳定"],
