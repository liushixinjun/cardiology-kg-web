  "event_rules": [
    {
      "id": "RULE_AMI_SCREEN_001",
      "name": "急诊胸痛疑似ACS筛查",
      "event": "EVT_EMR_SAVE",
      "scene": "急诊",
      "conditions": {
        "symptoms": ["胸痛", "胸闷", "压榨感", "大汗", "濒死感", "放射痛"],
        "logic": "ANY"
      },
      "output": {
        "action": "disease_recommendation",
        "content": "疑似急性冠脉综合征(ACS)",
        "level": "提醒",
        "recommended_exams": ["心电图", "肌钙蛋白I/T", "CK-MB"]
      },
      "knowledge_basis": "ESC NSTE-ACS Guidelines 2020 §3.1"
    },
    {
      "id": "RULE_AMI_STEMI_001",
      "name": "STEMI确诊规则",
      "event": "EVT_REPORT_BACK",
      "scene": "急诊/住院",
      "conditions": {
        "ecg": "ST段抬高≥0.1mV(相邻2导联)或新发LBBB",
        "biomarker": "cTn升高",
        "logic": "AND"
      },
      "output": {
        "action": "subtype_recommendation",
        "content": "STEMI",
        "level": "紧急",
        "recommended_actions": ["立即启动再灌注流程", "评估PCI/溶栓适应证"]
      },
      "knowledge_basis": "ESC STEMI Guidelines 2017 §4.2"
    },
    {
      "id": "RULE_AMI_NSTEMI_001",
      "name": "NSTEMI确诊规则",
      "event": "EVT_REPORT_BACK",
      "scene": "急诊/住院",
      "conditions": {
        "ecg": "无ST段抬高",
        "biomarker": "cTn动态升高和/或降低",
        "symptoms": "缺血性症状",
        "logic": "AND"
      },
      "output": {
        "action": "subtype_recommendation",
        "content": "NSTEMI",
        "level": "紧急",
        "recommended_actions": ["GRACE评分", "决定介入时机"]
      },
      "knowledge_basis": "ESC NSTE-ACS Guidelines 2020 §4.3"
    },
    {
      "id": "RULE_AMI_DIFF_001",
      "name": "鉴别诊断提示",
      "event": "EVT_DIAGNOSIS_SAVE",
      "scene": "急诊/住院",
      "conditions": {
        "diagnosis": "疑似AMI",
        "evidence_insufficient": true
      },
      "output": {
        "action": "differential_recommendation",
        "content": "需鉴别：主动脉夹层、肺栓塞、心包炎",
        "recommended_exams": ["D-二聚体", "CTA/CTPA", "心超"]
      },
      "knowledge_basis": "ESC NSTE-ACS Guidelines 2020 §3.2"
    },
    {
      "id": "RULE_PCI_CHECK_001",
      "name": "PCI术前禁忌证校验",
