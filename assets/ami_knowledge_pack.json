      "next_stage": "STAGE-CARD-CAD-AMI-REPERFUSION-DECISION"
    },
    "STAGE-CARD-CAD-AMI-REPERFUSION-DECISION": {
      "code": "STAGE-CARD-CAD-AMI-REPERFUSION-DECISION",
      "name": "再灌注决策阶段",
      "description": "STEMI患者：评估发病时间窗、PCI/溶栓适应证和禁忌证，决定再灌注策略",
      "entry_conditions": ["STEMI确诊", "发病<12h"],
      "exit_conditions": ["PCI方案确认", "溶栓方案确认", "超出时间窗转保守"],
      "available_plans": ["PLAN-CARD-CAD-AMI-PRIMARY-PCI", "PLAN-CARD-CAD-AMI-THROMBOLYSIS"],
      "blocking_rules": {
        "PCI_block": ["活动性出血", "严重凝血障碍", "主动脉夹层"],
        "thrombolysis_block": ["出血性卒中史", "近期大手术", "主动脉夹层"]
      },
      "clinical_rules": ["RULE-CARD-CAD-AMI-REPERFUSION-SELECT"],
      "next_stage": "STAGE-CARD-CAD-AMI-TREATMENT-EXECUTION"
    },
    "STAGE-CARD-CAD-AMI-TREATMENT-EXECUTION": {
      "code": "STAGE-CARD-CAD-AMI-TREATMENT-EXECUTION",
      "name": "治疗执行与监测阶段",
      "description": "执行已确认的治疗方案，持续监测并发症风险",
