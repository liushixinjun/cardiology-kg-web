      "name": "出院二级预防决策阶段",
      "description": "评估出院条件，确认二级预防方案完整性，生成随访计划",
      "entry_conditions": ["病情稳定", "达到出院标准"],
      "exit_conditions": ["二级预防方案完整", "随访计划生成"],
      "available_plans": ["PLAN-CARD-CAD-AMI-DISCHARGE-ORDERS"],
      "clinical_rules": ["RULE-CARD-CAD-AMI-SECONDARY-PREVENTION"],
      "next_stage": "STAGE-CARD-CAD-AMI-FOLLOWUP-MANAGEMENT"
    },
    "STAGE-CARD-CAD-AMI-FOLLOWUP-MANAGEMENT": {
      "code": "STAGE-CARD-CAD-AMI-FOLLOWUP-MANAGEMENT",
      "name": "随访管理阶段",
      "description": "出院后定期复查、用药依从性评估、再入院风险监测",
      "entry_conditions": ["出院后"],
      "exit_conditions": ["随访完成", "再入院"],
      "available_plans": ["PLAN-CARD-CAD-AMI-FOLLOWUP-PLAN"],
      "clinical_rules": ["RULE-CARD-CAD-AMI-FOLLOWUP-001"],
      "next_stage": null
    }
  },

  "stage_plan_map": {
