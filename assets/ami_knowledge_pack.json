{
  "version": "1.0.0",
  "disease_code": "DIS-CARD-CAD-AMI",
  "disease_name": "急性心肌梗死",
  "disease_name_en": "Acute Myocardial Infarction",
  "specialty": "心血管内科",

  "subtypes": {
    "STEMI": {
      "name": "ST段抬高型心肌梗死",
      "criteria": [
        "新发ST段抬高：相邻2个导联J点抬高≥0.1mV（V2-V3导联男性≥0.2mV，女性≥0.15mV）",
        "或新发左束支传导阻滞（LBBB）",
        "合并心肌标志物（cTnI/cTnT）升高"
      ],
      "urgency": "极高危",
      "time_window": "发病<12h为再灌注治疗时间窗"
    },
    "NSTEMI": {
      "name": "非ST段抬高型心肌梗死",
      "criteria": [
        "无ST段抬高",
        "心肌标志物（cTnI/cTnT）动态升高和/或降低",
        "缺血性症状（胸痛/胸闷等）"
      ],
      "urgency": "高危",
      "time_window": "根据GRACE评分决定介入时机"
    }
  },

  "diagnostic_workflow": {
    "step1_screening": {
      "name": "高危大类筛查",
      "trigger": "急诊主诉保存",
      "conditions": ["胸痛", "胸闷", "压榨感", "大汗", "濒死感", "放射痛"],
      "output": "疑似ACS",
      "next": "step2_evidence"
    },
    "step2_evidence": {
      "name": "证据补齐",
      "trigger": "心电图/检验回传",
      "required_exams": ["心电图", "肌钙蛋白I/T", "CK-MB"],
      "optional_exams": ["D-二聚体", "血气分析", "BNP/NT-proBNP", "心超"],
      "output": "证据充分/证据不足",
      "next": "step3_diagnosis"
    },
    "step3_diagnosis": {
      "name": "诊断确认与分型",
      "trigger": "诊断保存",
      "branching": {
        "STEMI": "ST段抬高或新发LBBB + cTn升高",
        "NSTEMI": "无ST段抬高 + cTn动态变化",
        "unstable_angina": "无ST段抬高 + cTn正常",
        "exclude": "心电图和cTn均正常"
      },
      "next": "step4_stratification"
    },
    "step4_stratification": {
      "name": "风险分层",
      "trigger": "评估完成",
      "scales": ["GRACE", "TIMI", "Killip"],
      "next": "step5_treatment"
    },
    "step5_treatment": {
      "name": "治疗决策",
      "trigger": "分型+分层完成",
      "next": "step6_monitoring"
    },
    "step6_monitoring": {
      "name": "治疗执行与监测",
      "trigger": "医嘱执行",
      "next": "step7_discharge"
    },
    "step7_discharge": {
      "name": "出院准备",
      "trigger": "病情稳定",
      "next": "step8_followup"
    },
    "step8_followup": {
      "name": "随访管理",
      "trigger": "出院后"
    }
  },

  "differential_diagnosis": [
    {
      "name": "主动脉夹层",
      "key_features": ["撕裂样疼痛", "双上肢血压差>20mmHg", "脉搏不对称"],
      "key_exams": ["主动脉CTA", "经食管超声心动图(TEE)", "D-二聚体"],
      "exclude_signs": ["CTA未见主动脉夹层征象"],
      "urgency": "极高危"
    },
    {
      "name": "肺栓塞",
      "key_features": ["突发呼吸困难", "胸痛", "咯血", "下肢深静脉血栓史"],
      "key_exams": ["CTPA", "D-二聚体", "血气分析", "下肢深静脉超声"],
      "exclude_signs": ["CTPA未见充盈缺损"],
      "urgency": "高危"
    },
    {
      "name": "急性心包炎",
      "key_features": ["胸痛与呼吸/体位相关", "心包摩擦音", "发热"],
      "key_exams": ["心超", "心电图（弥漫ST段弓背向下抬高）", "CRP/ESR"],
      "exclude_signs": ["无弥漫ST段弓背向下抬高"],
      "urgency": "中等"
    },
    {
      "name": "气胸",
      "key_features": ["突发胸痛", "呼吸困难", "患侧呼吸音消失"],
      "key_exams": ["胸部X线", "胸部CT"],
      "exclude_signs": ["胸片未见气胸征象"],
      "urgency": "高危"
    }
  ],

  "risk_scales": {
    "GRACE": {
      "name": "GRACE评分（全球急性冠脉事件注册评分）",
      "applicable": "所有ACS患者",
      "fields": [
        {"id": "age", "label": "年龄(岁)", "type": "number", "max_score": 100},
        {"id": "heart_rate", "label": "心率(次/分)", "type": "number", "max_score": 46},
        {"id": "systolic_bp", "label": "收缩压(mmHg)", "type": "number", "max_score": 58},
        {"id": "creatinine", "label": "肌酐(mg/dL)", "type": "number", "max_score": 28},
        {"id": "killip_class", "label": "Killip分级", "type": "select", "options": ["I","II","III","IV"], "scores": [0,20,39,59]},
        {"id": "cardiac_arrest", "label": "就诊时心脏骤停", "type": "boolean", "scores": [0,39]},
        {"id": "st_deviation", "label": "ST段偏移", "type": "boolean", "scores": [0,28]},
        {"id": "biomarker_elevated", "label": "心肌标志物升高", "type": "boolean", "scores": [0,14]}
      ],
      "risk_levels": [
        {"level": "低危", "range": "≤108", "in_hospital_mortality": "<3%", "color": "#51cf66"},
        {"level": "中危", "range": "109-140", "in_hospital_mortality": "3-8%", "color": "#ffd43b"},
        {"level": "高危", "range": "141-372", "in_hospital_mortality": ">8%", "color": "#ff6b6b"}
      ],
      "source": "GRACE Risk Score, Eur Heart J 2007"
    },
    "TIMI": {
      "name": "TIMI评分（NSTEMI/UA）",
      "applicable": "NSTEMI/不稳定型心绞痛",
      "fields": [
        {"id": "age_ge65", "label": "年龄≥65岁", "type": "boolean", "score": 1},
        {"id": "cad_risk_factors", "label": "≥3个CAD危险因素", "type": "boolean", "score": 1},
        {"id": "known_cad_stenosis", "label": "已知冠脉狭窄≥50%", "type": "boolean", "score": 1},
        {"id": "st_deviation", "label": "ST段偏移≥0.5mm", "type": "boolean", "score": 1},
        {"id": "severe_angina", "label": "24h内严重心绞痛≥2次", "type": "boolean", "score": 1},
        {"id": "aspirin_7days", "label": "近7天内服用阿司匹林", "type": "boolean", "score": 1},
        {"id": "biomarker_elevated", "label": "心肌标志物升高", "type": "boolean", "score": 1}
      ],
      "risk_levels": [
        {"level": "低危", "range": "0-2分", "14d_events": "4.7%", "color": "#51cf66"},
        {"level": "中危", "range": "3-4分", "14d_events": "8.3-13.2%", "color": "#ffd43b"},
        {"level": "高危", "range": "5-7分", "14d_events": "19.9-40.9%", "color": "#ff6b6b"}
      ],
      "source": "TIMI Risk Score, JAMA 2000"
    },
    "Killip": {
      "name": "Killip分级",
      "applicable": "AMI患者心功能评估",
      "levels": [
        {"grade": "I", "criteria": "无心衰征象，无肺部啰音", "mortality": "6%", "color": "#51cf66"},
        {"grade": "II", "criteria": "轻-中度心衰，肺部湿啰音<50%肺野，S3奔马律，颈静脉怒张", "mortality": "17%", "color": "#ffd43b"},
        {"grade": "III", "criteria": "重度心衰/急性肺水肿，湿啰音>50%肺野", "mortality": "38%", "color": "#ff922b"},
        {"grade": "IV", "criteria": "心源性休克，收缩压<90mmHg，少尿，意识障碍", "mortality": "81%", "color": "#ff6b6b"}
      ],
      "source": "Killip & Kimball, Am J Cardiol 1967"
    },
    "HAS_BLED": {
      "name": "HAS-BLED出血风险评分",
      "applicable": "评估抗栓治疗出血风险",
      "fields": [
        {"id": "hypertension", "label": "高血压（收缩压>160mmHg）", "type": "boolean", "score": 1},
        {"id": "abnormal_renal", "label": "肾功能异常", "type": "boolean", "score": 1},
        {"id": "abnormal_liver", "label": "肝功能异常", "type": "boolean", "score": 1},
        {"id": "stroke", "label": "卒中史", "type": "boolean", "score": 1},
        {"id": "bleeding", "label": "出血史/倾向", "type": "boolean", "score": 1},
        {"id": "labile_inr", "label": "INR不稳定", "type": "boolean", "score": 1},
        {"id": "elderly", "label": "年龄>65岁", "type": "boolean", "score": 1},
        {"id": "drugs", "label": "抗血小板/NSAIDs", "type": "boolean", "score": 1},
        {"id": "alcohol", "label": "酗酒", "type": "boolean", "score": 1}
      ],
      "risk_levels": [
        {"level": "低危", "range": "0-2分", "color": "#51cf66"},
        {"level": "高危", "range": "≥3分", "color": "#ff6b6b", "note": "高出血风险，需加强监测"}
      ],
      "source": "HAS-BLED, Eur Heart J 2010"
    }
  },

  "pathway_stages": {
    "STAGE-CARD-CAD-AMI-SCREENING": {
      "code": "STAGE-CARD-CAD-AMI-SCREENING",
      "name": "高危筛查决策阶段",
      "description": "判断患者是否属于高危方向，是否需要进入AMI诊疗流程",
      "entry_conditions": ["胸痛", "胸闷", "压榨感", "大汗", "濒死感"],
      "exit_conditions": ["排除ACS", "证据不足留观"],
      "available_plans": ["PLAN-CARD-CAD-AMI-ECG-TROPONIN-ORDER"],
      "clinical_rules": ["RULE-CARD-CAD-AMI-SCREEN-001"],
      "next_stage": "STAGE-CARD-CAD-AMI-EVIDENCE"
    },
    "STAGE-CARD-CAD-AMI-EVIDENCE": {
      "code": "STAGE-CARD-CAD-AMI-EVIDENCE",
      "name": "证据补齐决策阶段",
      "description": "收集心电图、肌钙蛋白、心肌酶等诊断依据，判断证据是否充分",
      "entry_conditions": ["疑似ACS筛查阳性"],
      "exit_conditions": ["证据充分进入分型", "证据不足继续观察"],
      "available_plans": ["PLAN-CARD-CAD-AMI-ECG-TROPONIN-ORDER", "PLAN-CARD-CAD-AMI-DIFFERENTIAL-ORDER"],
      "clinical_rules": ["RULE-CARD-CAD-AMI-STEMI-001", "RULE-CARD-CAD-AMI-NSTEMI-001", "RULE-CARD-CAD-AMI-DIFF-001"],
      "next_stage": "STAGE-CARD-CAD-AMI-SUBTYPING"
    },
    "STAGE-CARD-CAD-AMI-SUBTYPING": {
      "code": "STAGE-CARD-CAD-AMI-SUBTYPING",
      "name": "分型分层决策阶段",
      "description": "根据心电图和肌钙蛋白判断STEMI/NSTEMI，完成风险评分",
      "entry_conditions": ["心电图异常", "肌钙蛋白升高"],
      "exit_conditions": ["STEMI确诊", "NSTEMI确诊", "排除AMI"],
      "available_plans": ["PLAN-CARD-CAD-AMI-GRACE-ASSESSMENT", "PLAN-CARD-CAD-AMI-TIMI-ASSESSMENT"],
