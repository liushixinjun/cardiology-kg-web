        {"plan_code": "PLAN-CARD-CAD-AMI-THROMBOLYSIS", "plan_name": "溶栓治疗方案", "priority": 2, "conditions": ["STEMI确诊", "发病<12h", "无法行急诊PCI", "无溶栓禁忌证"]}
