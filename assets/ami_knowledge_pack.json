        "PLAN-CARD-CAD-AMI-THROMBOLYSIS": ["活动性出血", "出血性卒中史", "近期大手术", "主动脉夹层"]
      }
    },
    "STAGE-CARD-CAD-AMI-TREATMENT-EXECUTION": {
      "stage_name": "治疗执行与监测阶段",
