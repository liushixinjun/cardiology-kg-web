      "clinical_rules": ["RULE-CARD-CAD-AMI-PCI-CHECK-001"],
      "next_stage": "STAGE-CARD-CAD-AMI-COMPLICATION-MONITORING"
    },
    "STAGE-CARD-CAD-AMI-COMPLICATION-MONITORING": {
      "code": "STAGE-CARD-CAD-AMI-COMPLICATION-MONITORING",
      "name": "并发症监测阶段",
      "description": "监测心衰、心律失常、出血等并发症风险，触发异常分支",
      "entry_conditions": ["治疗执行中"],
      "exit_conditions": ["无并发症转入出院准备", "出现并发症转入处置"],
      "available_plans": ["PLAN-CARD-CAD-AMI-DISCHARGE-PREP"],
      "clinical_rules": ["RULE-CARD-CAD-AMI-RISK-001"],
      "next_stage": "STAGE-CARD-CAD-AMI-DISCHARGE-SECONDARY-PREVENTION"
    },
    "STAGE-CARD-CAD-AMI-DISCHARGE-SECONDARY-PREVENTION": {
